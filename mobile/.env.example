# Copy this file to .env and fill it in on this machine. Never commit the filled-in file.
# Every value here is public information: the publishable key is public by design, and no secret
# key is ever read by the phone app.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.eu.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=your_auth0_client_id
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.owanbe.app
