# Copy to .env.local. Only the variables listed here are exposed to the browser.
# Never put secrets (Auth0 client secret, Supabase service-role key) in this file.

# Canonical public origin of the web app (no trailing slash).
APP_ORIGIN=http://localhost:8080

# Auth0 (F-76): Single Page Application + API. See docs/auth0-setup.md
AUTH0_DOMAIN=owanbe-dev.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://api.owanbe.app

# Supabase (public URL + publishable/anon key only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLIC_KEY=

# ---- Server-only settings (F-79). Store as project secrets, never in this file. ----
# APP_ENV=development|staging|production
# SUPABASE_SERVICE_ROLE_KEY=
# SENTRY_DSN=
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# Browser copies in this project use the VITE_ prefix, e.g. VITE_AUTH0_DOMAIN, VITE_SUPABASE_URL.
