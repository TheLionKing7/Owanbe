# Owner decision 2026-11-05 (Sage 7 question 53116a71): resolve peer dependencies the way npm v6
# did. Without this, `npm install` cannot finish — @testing-library/react advertises a peerOptional
# on @types/react@^18 while this app pins 19, and npm aborts on that alone.
# Cost: npm stops warning about genuinely incompatible peers, so package-lock.json (refreshed by
# `npm install`) and `npm ci` are the authority on what gets installed, not the peer graph.
legacy-peer-deps=true
